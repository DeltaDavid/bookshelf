{
  "env": {
    "browser": true,
    "es2021": true
  },
  "plugins": ["html"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["ask-me-kit.js", "bookshelf-ask.js", "bookshelf-ask.test.js"],
      "parserOptions": { "sourceType": "module" },
      "env": { "node": true }
    }
  ],
  "rules": {
    "no-var": "error",
    "prefer-const": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "no-duplicate-imports": "error",
    "no-undef": "off"
  }
}
